// Parse-only ceff/leak derate study for power.arch1 @2.0.0: scalars < 1.
// Expect proportional Pdyn/Pleak drop and unchanged timing. Replays
// golden.bbin like golden_derate.bbin but covers the full derate grid.
// Not executed: the import is resolved and the per-point partial SoCs are
// sealed by backends.
using power.arch1 @"2.0.0"
import (base as g: ~SoC) from rel:'golden.bbin'

let derates: {Scalars} = {Scalars { ceffMult = 1.0, leakMult = 1.0, perfAdj = 1.0 }, Scalars { ceffMult = 0.9, leakMult = 1.0, perfAdj = 1.0 }, Scalars { ceffMult = 1.0, leakMult = 0.8, perfAdj = 1.0 }, Scalars { ceffMult = 0.9, leakMult = 0.8, perfAdj = 1.0 }}

with provenance({model = "power.arch1", modelVersion = "2.0.0", dataVersion = "derate-x0.9-x0.8", tool = "baboon"}) {
  g.scalars.perfAdj = 1.0
}

for ((idx, row) in derates) {
  let point: ~SoC = g
  // TODO(lower): set point.scalars from row, seal to SoC, and call
  // pdyn/pleak/ptotal/eop/perfW per derate; sealed-fn calls are not yet expressible.
  let sealed: SoC = point.seal()
}
