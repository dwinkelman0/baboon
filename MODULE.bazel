# aspect_rules_js 2.8.3 floor-pins aspect_bazel_lib 2.17.1, whose toolchain
# rules pass `incompatible_use_toolchain_transition` (removed in Bazel 9).
# Pin a newer release whose lib/private/*_toolchain.bzl no longer uses that
# kwarg (verified: 9 hits in 2.17.1, 0 in 2.19.4 tarballs); MVS keeps this.
bazel_dep(name = "aspect_bazel_lib", version = "2.19.4")
# rules_nodejs 6.3.0's nodejs_toolchains_repo.bzl passes
# `incompatible_use_toolchain_transition` (removed in Bazel 9), and its
# nodejs/toolchain.bzl uses the implicit CcInfo global (removed in Bazel 9).
# 6.7.3 is the first 6.7.x release (minimal bump carrying both upstream
# fixes; verified: 0 kwarg hits, CcInfo loaded from @rules_cc//cc:defs.bzl).
# Satisfies aspect_rules_js 2.8.3's 6.3.0 floor so MVS stays quiet.
bazel_dep(name = "rules_nodejs", version = "6.7.3")
bazel_dep(name = "rules_kotlin", version = "2.3.20")
bazel_dep(name = "rules_dart", version = "0.10.0")
