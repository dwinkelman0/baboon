# --- JavaScript/TypeScript (ts-stub: TS ~5.7.0, vitest ~3.0.0, node 24) ---
# npm translation of the pnpm workspace lockfile. The workspace root owns the
# lockfile (importers `.` and `test/ts-stub`) because test/* dirs carry no
# BUILD files yet, so their labels cannot be watched by the extension; the
# ts-stub BUILD step can add per-package entries later.
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")

# --- Kotlin (kt-stub, JVM_21) ---
# NOTE: rules_kotlin's bundled kotlinc is used (not the project's 2.1.0):
# mixing rules 2.3.x worker classes with a separately downloaded kotlinc
# 2.1.0 crashes the FIR checker phase (AbstractMethodError on
# FirDeclarationChecker: worker compiled against newer FIR API than the
# downloaded compiler provides). Revisit with rules_kotlin 2.1.x if exact
# compiler fidelity is ever required.
rules_kotlin_extensions = use_extension("@rules_kotlin//src/main/starlark/core/repositories:bzlmod_setup.bzl", "rules_kotlin_extensions")
use_repo(
    rules_kotlin_extensions,
    "com_github_google_ksp",
    "com_github_jetbrains_kotlin",
    "com_github_jetbrains_kotlin_git",
    "com_github_pinterest_ktlint",
    "kotlin_build_tools_impl",
    "kotlinx_coroutines_core_jvm",
    "kotlinx_serialization_core_jvm",
    "kotlinx_serialization_json",
    "kotlinx_serialization_json_jvm",
)

# --- Dart (dt-stub, sdk ^3.0.0) ---
# No dart.toolchain tag: use rules_dart 0.10.0's pinned SDK (Dart 3.x),
# which satisfies the stub's ^3.0.0 constraint. Pin an exact dart_version
# here only if a stub needs a newer SDK than the pinned one.
dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")

