    name = "jline",
    sha256 = "8dd8b58f38a0d428d51c1dd0bcc5ea2086850cad60851faf55fa82c0a17f9c0c",
    url = "https://repo1.maven.org/maven2/org/jline/jline/4.4.5/jline-4.4.5.jar",
