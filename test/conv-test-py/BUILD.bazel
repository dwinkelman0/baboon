# Python conv-test lane over test/conv-test models (cargo/mdl parity:
# test/conv-test-py/).
# Mirrors test/py-stub/BUILD.bazel (py_library/py_test @rules_python) with model_dir="test/conv-test" and
# models="//test/conv-test:models". Full baboon_codegen + compiled library
# wiring is deferred until the generated file list is pinned (same workflow
# as test/conv-test-rs/BUILD.bazel CONV_GENERATED TODO and the sibling
# stub's generated.bzl): baboon_codegen requires explicit outs, so the
# file set must come from a first codegen run. Until then these filegroups
# keep the lane queryable and document the intended flags:
# --py-write-evolution-dict=true, --py-wrapped-adt-branch-codecs=false + ueba/json codecs by default.

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "conv_test_py_models",
    srcs = ["//test/conv-test:models"],
    tags = ["manual"],
)

filegroup(
    name = "conv_test_py_sources",
    srcs = glob(["**/*"], exclude = ["BUILD.bazel"]),
    tags = ["manual"],
)

# Aggregate lane target (keeps `bazel query //test/conv-test-py/...` matching
# `conv_test` until the compiled codegen lane lands).
filegroup(
    name = "conv_test",
    srcs = [
        ":conv_test_py_models",
        ":conv_test_py_sources",
    ],
    tags = ["manual"],
)
