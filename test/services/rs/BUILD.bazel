load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//tools/bazel:baboon.bzl", "baboon_codegen")

package(default_visibility = ["//visibility:public"])

# Sync petstore service (petstore.baboon). The compiler emits the service
# modules into src/generated/; src/main.rs consumes them via `mod generated;`
# alongside the hand-written petstore_impl/server/client modules.
# TODO: re-list SERVICE_GENERATED after the first codegen run and pin the
# service extra_args against the test-gen-rs-wiring CI lane (same workflow
# as test/rs-stub/generated.bzl).
SERVICE_GENERATED = [
    "src/generated/mod.rs",
]

baboon_codegen(
    name = "gen_service",
    compiler_jar = "//baboon-compiler:baboon-bin_deploy.jar",
    extra_args = [
        "--generate-ueba-codecs-by-default=true",
        "--generate-json-codecs-by-default=true",
    ],
    fixture_output = "src/generated",
    lang = ":rust",
    model_dir = "test/services",
    models = "//test/services:petstore",
    output = "src/generated",
    test_output = "src/generated",
    outs = SERVICE_GENERATED,
)

rust_binary(
    name = "rs_service",
    srcs = glob(
        ["src/*.rs"],
        exclude = ["src/generated/**"],
    ) + SERVICE_GENERATED,
    crate_features = [
        "decimal",
        "json-helpers",
        "timestamps",
        "uuids",
    ],
    crate_name = "baboon_rs_service",
    edition = "2021",
    deps = [
        "@rs_stub_deps//:serde",
        "@rs_stub_deps//:serde_json",
        "@rs_stub_deps//:chrono",
        "@rs_stub_deps//:uuid",
        "@rs_stub_deps//:rust_decimal",
        "@rs_stub_deps//:tiny_http",
        "@rs_stub_deps//:ureq",
    ],
)
