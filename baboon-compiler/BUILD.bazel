# Single compilation unit mirroring sbt's baboonJVM project (CrossType.Pure):
# shared sources plus JVM platform sources. Scala.js sources under .js/ are
# intentionally excluded (they need the Scala.js toolchain, out of scope).
# NOTE: BaboonRuntimeResources.scala is excluded here; the `resources` map it
# used to embed via the izumi PortableResource macro (which requires build.sbt
# on disk and fails under Bazel) is generated by :gen_runtime_resources instead.
scala_library(
    name = "baboon",
    srcs = glob(
        [
            "src/main/scala/**/*.scala",
            ".jvm/src/main/scala/**/*.scala",
        ],
        exclude = ["src/main/scala/io/septimalmind/baboon/translator/BaboonRuntimeResources.scala"],
    ) + [":gen_runtime_resources"],
    plugins = ["@maven//:org_typelevel_kind_projector_2_13_18"],
    resources = glob(["src/main/resources/**"]),
    scalacopts = SCALAC_OPTS,
    deps = MAVEN_DEPS,
)

scala_binary(
    name = "baboon-bin",
    main_class = "io.septimalmind.baboon.Baboon",
    runtime_deps = [":baboon"],
)

# Compiler unit tests, mirroring sbt's baboonJVM/test lane (the sbt test gap).
# JVM platform test sources only; src/test/scala and .js/ carry no test files.
# resources covers all of src/test/resources (including the .baboon corpus
# also exposed as :codegen_models), so suites reading fixtures from the
# classpath resolve the same files as under sbt.
# ZipPath gap (fixed): suites resolved fixture dirs via
# IzResources.getPath(...).asInstanceOf[LoadablePathReference].path + .toFile /
# IzFiles.walk. Under sbt resources are loose files; under Bazel they are packed
# in the test jar, so the path is a ZipPath and .toFile throws
# UnsupportedOperationException. Shared helper TestResources (fixturePath/fixtureDir
# in .jvm/src/test/scala/.../tests/TestResources.scala) now materializes
# jar/zip trees to a temp dir when path.getFileSystem != FileSystems.getDefault,
# and all LoadablePathReference call sites route through it (fast path unchanged
# for file: URLs).
# Parity gap (fixed): IdentifierRuntimeParityTest and TypeMetaCodecParityTest
# read the compile-side BaboonRuntimeShared.scala from the source tree; it rides
# along as :compile_sources data and the suites resolve it via
# $TEST_SRCDIR/$TEST_WORKSPACE with an sbt-compatible cwd-walk fallback.
scala_test(
    name = "baboon_test",
    srcs = glob([".jvm/src/test/scala/**/*.scala"]),
    # Materialize the .baboon corpus as real runfiles files: several suites
    # resolve fixture directories through the runfiles tree
    # ($TEST_SRCDIR/_main/baboon-compiler/src/test/resources/baboon), which
    # only exists when the filegroup rides along as data.
    data = [":codegen_models", ":compile_sources"],
    plugins = ["@maven//:org_typelevel_kind_projector_2_13_18"],
    resources = glob(["src/test/resources/**"]),
    scalacopts = SCALAC_OPTS,
    deps = [":baboon"] + MAVEN_DEPS + MAVEN_TEST_DEPS,
)

filegroup(
    name = "runtime_templates",
    srcs = glob(["src/main/resources/baboon-runtime/**"]),
)

# .baboon contracts used as codegen inputs for all language stubs.
filegroup(
    name = "codegen_models",
    srcs = glob(["src/test/resources/baboon/**"]),
)

# Compile-side Scala sources read directly by parity suites
# (IdentifierRuntimeParityTest, TypeMetaCodecParityTest). Under sbt the suites
# resolve them by walking up from the working directory; under Bazel the tests
# run with a runfiles cwd, so the sources must ride along as `data` and the
# suites resolve them via $TEST_SRCDIR/$TEST_WORKSPACE.
filegroup(
    name = "compile_sources",
    srcs = ["src/main/scala/baboon/runtime/shared/BaboonRuntimeShared.scala"],
)

# Template files embedded into the compiler (replaces the izumi
# PortableResource.embedSources macro, which cannot run under Bazel).
filegroup(
    name = "runtime_resource_files",
    srcs = glob(["src/main/resources/baboon-runtime/**"]),
)

genrule(
    name = "gen_runtime_resources",
    srcs = [":runtime_resource_files"],
    outs = ["BaboonRuntimeResourcesGen.scala"],
    cmd = "$(location //scripts:gen_baboon_resources) --out $@ $(locations :runtime_resource_files)",
    tools = ["//scripts:gen_baboon_resources"],
)

# GraalVM native-image, flags mirrored from build.sbt graalVMNativeImageOptions.
# Linux amd64 adds --static --libc=musl via select; keep --no-fallback everywhere.
genrule(
    name = "baboon-native",
    srcs = [":baboon-bin_deploy.jar"],
    outs = ["baboon-native-bin"],
    cmd = """
        NATIVE_IMAGE=$$(ls $$GRAALVM_HOME/bin/native-image 2>/dev/null || which native-image)
        EXTRA=""; \
        if [ "$$(uname -s)" = "Linux" ] && [ "$$(uname -m)" = "x86_64" ]; then EXTRA="--static --libc=musl"; fi; \
        $$NATIVE_IMAGE \
          -H:-CheckToolchain \
          -H:+UnlockExperimentalVMOptions \
          --no-fallback \
          -H:+ReportExceptionStackTraces \
          --report-unsupported-elements-at-runtime \
          --enable-https \
          --enable-http \
          -march=compatibility \
          $$EXTRA \
          -jar $(location :baboon-bin_deploy.jar) $(location :baboon-native-bin)
    """,
    executable = True,
    # Manual: requires a GraalVM JDK with native-image on PATH; excluded from
    # wildcard builds (//baboon-compiler/...) until the GraalVM 23 toolchain is wired.
    tags = ["manual", "no-remote-exec", "requires-network"],
    toolchains = ["@bazel_tools//tools/jdk:current_java_runtime"],
)
